DB_HOST=localhost
DB_PORT=5432
DB_NAME=mentify
DB_USERNAME=mentify
DB_PASSWORD=mentify_local

# Google OAuth (set GOOGLE_OAUTH_ENABLED=true outside local/dev)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=http://localhost:3000/auth/callback

# Account email flows (keep false locally unless SMTP is configured)
MAIL_ENABLED=false
MAIL_FROM=no-reply@mentify.vn
MAIL_BASE_URL=http://localhost:3000
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
