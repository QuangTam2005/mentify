# Mentify Frontend Environment Configuration

# Backend API Base URL (Dùng cho Client-side fetch qua Next.js proxy hoặc direct)
# Mặc định để trống để đi qua rewrite proxy /api/v1 -> Backend:8080
NEXT_PUBLIC_API_BASE_URL=

# Backend Internal URL (Dùng cho Next.js server-side rewrites & SSR fetch)
NEXT_PUBLIC_BACKEND_INTERNAL_URL=http://localhost:8080

# Môi trường ứng dụng: local | development | staging | production
NEXT_PUBLIC_APP_ENV=local

# Bật Đăng nhập nhanh cho Lập trình viên (Yêu cầu đồng thời NODE_ENV=development và NEXT_PUBLIC_ENABLE_DEV_LOGIN=true, mặc định: tắt)
# NEXT_PUBLIC_ENABLE_DEV_LOGIN=true

# Google OAuth2 Login URL
NEXT_PUBLIC_GOOGLE_AUTH_URL=http://localhost:8080/oauth2/authorization/google

# Business Timezone
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
